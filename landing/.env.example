NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRO_MONTHLY_PRICE=3,99 €
NEXT_PUBLIC_PRO_ANNUAL_PRICE=29,99 €
NEXT_PUBLIC_PRO_MONTHLY_EQUIVALENT=2,50 € / mois
NEXT_PUBLIC_CONTACT_EMAIL=contact@punaise.cloud

# Optional: redirect the free download button to a hosted DMG.
# When unset, the site serves public/downloads/Punaise-Free.dmg.
FREE_DOWNLOAD_URL=
APP_DOWNLOAD_VERSION=0.1.6

# Pro licenses are signed after a paid Stripe Checkout Session.
# Store the matching P-256 private key as base64 in production.
PUNAISE_LICENSE_PRIVATE_KEY_B64=
# Alternative local format: escaped PEM value.
PUNAISE_LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Use Stripe Checkout Sessions so Punaise can issue a signed license key.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_CHECKOUT_MODE=subscription
STRIPE_WEBHOOK_SECRET=

# Contact form storage. On the VPS, keep this outside generated build folders.
CONTACT_MESSAGES_PATH=/var/www/punaise/data/contact-messages.jsonl
